# Written by ./llm setup for this machine; the values below are examples.
# Where the models are (the Hugging Face cache) and where Strata keeps its packs and caches. Absolute paths.
HF_HUB=/home/me/.cache/huggingface/hub
DATA_DIR=/home/me/local-llm/data

# User and groups the containers run with
UID_GID=1000:1000
RENDER_GID=989
VIDEO_GID=985
DOCKER_GID=966

# The R9700's PCI address (ls /dev/dri/by-path)
GPU_PCI=0000:03:00.0

# The API (llama-swap). 127.0.0.1 = this machine only; the LAN address (e.g. 192.168.1.20) or 0.0.0.0 = other machines too.
# There is no API key: only open it on a network you trust.
BIND_ADDR=127.0.0.1
API_PORT=8000
# Host names clients use to reach the API (comma-separated; a leading dot = a whole domain). IP addresses always work.
ALLOWED_HOSTS=my-server

# Strata tuning (both models)
STRATA_CONTEXT=262144
STRATA_PREFILL=auto
STRATA_SPEC=4
STRATA_HIP_WMMA=1
STRATA_EXTRA_ARGS=
